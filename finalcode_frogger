#include <SFML/Graphics.hpp>
#include <optional>
#include <vector>
#include <algorithm>
#include <string>
#include <cmath>
#include <fstream>
#include <cstdlib>      //uses rand and srand to randomly generate things, eg obstacles
#include <ctime>
using namespace std;
using namespace sf;

struct Log {
    RectangleShape shape;       //RectangleShape is the keyword for making a rectangle
    float speed;
};
struct LilyPad {
    ConvexShape shape;      //ConvexShape(n) is the syntax for making any n-sided polygon
    float speed;
};
struct Car
{
    RectangleShape shape;
    float speed;
};
struct WaterWave
{
    vector<CircleShape> dots;
    float speed;            //speed is taken as float to ensure smooth flow 
};
struct Coin { CircleShape shape; };
int main() {
    RenderWindow window(VideoMode({ 800, 650 }),           //this is the width and height of game window
        "Frogger Game"
    );
    window.setFramerateLimit(60);       //this is the maximum refresh rate of frames
    RectangleShape background({ 800, 650 });        //this is the window for setting background i.e grass
    background.setFillColor(Color(50, 150, 60));
    RectangleShape goal({ 800, 75 });       //this is for the dark green patch of grass
    goal.setPosition({ 0, 0 });
    goal.setFillColor(Color(30, 180, 70));
    RectangleShape house({ 100, 45 });
    house.setPosition({ 350, 25 });
    house.setFillColor(Color(139, 69, 19));
    ConvexShape roof;       //the roof is triangular so it will have 3 positions, one for each side
    roof.setPointCount(3);
    roof.setPoint(0, { 340, 25 });
    roof.setPoint(1, { 400, -10 });
    roof.setPoint(2, { 460, 25 });
    roof.setFillColor(Color::Red);
    RectangleShape door({ 25, 35 });
    door.setPosition({ 387, 35 });
    door.setFillColor(Color(80, 40, 20));
    RectangleShape houseWindow({ 20, 18 });
    houseWindow.setPosition({ 360, 38 });       //setPosition tells the location of our object wrt original window 
    houseWindow.setFillColor(Color::Cyan);
    RectangleShape river({ 800, 130 });
    river.setPosition({ 0, 115 });
    river.setFillColor(Color(0, 100, 255));
    RectangleShape riverTop({ 800, 4 });        //this is the size of river's outer lining
    riverTop.setPosition({ 0, 115 });
    riverTop.setFillColor(Color::White);
    RectangleShape riverBottom({ 800, 4 });
    riverBottom.setPosition({ 0, 241 });
    riverBottom.setFillColor(Color::White);
    vector<WaterWave> waterWaves;
    int waveHeights[3] = { 150, 165, 200 };   //three sets of waves were used initially but the middle wave is SKIPPED as increment is of 2 in for loop.
    for (int h = 0; h <= 2; h += 2) {
        int y = waveHeights[h];
        for (int x = 0; x < 800; x += 200) {         //this loop  maintains gap b/w waves in the same line
            WaterWave wave;
            if (y == 150) wave.speed = -45.f;       //the wave (150) flows in direction oposite to increase of x-axis
            else wave.speed = 45.f;

            for (int i = 0; i < 9; i++) {
                CircleShape dot(2.5f);
                float waveY =
                    static_cast<float>(y) + sin(i * 0.8f) * 4.f;       //trigonometric ratio sin gives the wave the movment like sin-wave
                dot.setPosition({ static_cast<float>(x + i * 10), waveY });
                dot.setFillColor(Color(150, 220, 255));
                wave.dots.push_back(dot);
            }
            waterWaves.push_back(wave);
        }
    }
    RectangleShape road({ 800, 165 });
    road.setPosition({ 0, 295 });
    road.setFillColor(Color(65, 65, 65));
    CircleShape frog(15);
    frog.setFillColor(Color::Green);
    frog.setPosition({ 385, 610 });
    vector<Car> cars;
    vector<Log> logs;
    vector<LilyPad> lilyPads;
    auto addLog = [&](float x, float y, float speed) {        //it uses the position coordinates x,y and the traversal speed
        RectangleShape log({ 120.f, 25.f });
        log.setPosition({ x, y });          //this x,y is given through the function
        log.setFillColor(Color(120, 65, 25));
        logs.push_back({ log, speed });     //this adds a new vector(log)
        };

    auto addLilyPad = [&](float x, float y, float speed) {
        ConvexShape pad;
        pad.setPointCount(7);       //the lily is a heptagon, 7-sided polygon
        pad.setPoint(0, { 32.f, 0.f });
        pad.setPoint(1, { 53.f, 7.f });
        pad.setPoint(2, { 65.f, 20.f });
        pad.setPoint(3, { 48.f, 34.f });
        pad.setPoint(4, { 20.f, 34.f });
        pad.setPoint(5, { 0.f, 20.f });
        pad.setPoint(6, { 15.f, 12.f });
        pad.setPosition({ x, y });
        pad.setFillColor(Color(50, 180, 50));
        pad.setOutlineColor(Color(20, 110, 25));
        pad.setOutlineThickness(2.f);       //this adds a boundary line outside any shape
        lilyPads.push_back({ pad, speed });
        };
    ///following are the positions and speeds of logs and lilypads
    addLog(30, 130, 65);
    addLog(350, 130, 65);
    addLog(670, 130, 65);
    addLilyPad(100, 160, -55);
    addLilyPad(350, 160, -55);
    addLilyPad(600, 160, -55);
    addLog(150, 210, 80);
    addLog(500, 210, 80);
    //NOTE:all the y coordinates for particular shape have been kept same to make them move the same line of action
    auto addCar = [&](float x, float y, Color color, float speed) {
        RectangleShape car({ 65, 32 });
        car.setPosition({ x, y });
        car.setFillColor(color);
        cars.push_back({ car, speed });
        };
    addCar(50, 290, Color::Red, 180);
    addCar(367.5f, 290, Color::Red, 180);
    addCar(685, 290, Color::Red, 180);
    addCar(100, 350, Color::Blue, -150);   //blue cars have negative spped because they move opposite to other cars
    addCar(400, 350, Color::Blue, -150);
    addCar(700, 350, Color::Blue, -150);
    addCar(223, 410, Color::Yellow, 200);
    addCar(512, 410, Color::Yellow, 200);
    //following initial conditions are always restored at start of every game
    Clock clock;        //Clock is the function of SFML, clock is the variable name
    int lives = 3;
    bool victory = false;
    int coinsCollected = 0;
    int maxCoins = 0;
    float bestTime = 0.f;
    { ifstream info("info.txt"); if (info >> maxCoins >> bestTime) {} }
    float finalElapsed = 0.f;
    vector<Coin> coins;
    Clock coinSpawnClock;
    Clock bonusDisplayClock;
    bool showBonus = false;
    srand(static_cast<unsigned>(time(nullptr)));   // time() gets the current system time.
    //nullptr tells it to return the current time rather than store it in a variable.
    vector<ConvexShape> hearts;     //convex shape makes it easy to draw heart
    for (int i = 0; i < 3; i++) {
        ConvexShape heart;
        heart.setPointCount(12);
        heart.setPoint(0, { 20.f, 40.f });
        heart.setPoint(1, { 5.f, 25.f });
        heart.setPoint(2, { 0.f, 15.f });
        heart.setPoint(3, { 2.f, 7.f });
        heart.setPoint(4, { 8.f, 2.f });
        heart.setPoint(5, { 15.f, 3.f });
        heart.setPoint(6, { 20.f, 10.f });
        heart.setPoint(7, { 25.f, 3.f });
        heart.setPoint(8, { 32.f, 2.f });
        heart.setPoint(9, { 38.f, 7.f });
        heart.setPoint(10, { 40.f, 15.f });
        heart.setPoint(11, { 35.f, 25.f });
        heart.setFillColor(Color::Red);
        heart.setOutlineColor(Color::White);
        heart.setOutlineThickness(1.5f);
        heart.setScale({ 0.9f, 0.9f });     //this is for span/size of heart
        heart.setPosition({ 20.f + i * 48.f, 570.f });
        hearts.push_back(heart);
    }

    Clock gameTimer;

    CircleShape timerCircle(35.f);      //this appears at the bottom right
    timerCircle.setPosition({ 720.f, 570.f });
    timerCircle.setFillColor(Color(35, 35, 35));
    timerCircle.setOutlineThickness(4.f);
    timerCircle.setOutlineColor(Color::Yellow);
    Font timerFont;
    bool timerFontLoaded = timerFont.openFromFile("C:/Windows/Fonts/arial.ttf");
    Text timerText(timerFont);
    timerText.setCharacterSize(24);
    timerText.setFillColor(Color::White);
    timerText.setString("30");
    Text bonusText(timerFont);
    bonusText.setCharacterSize(22);
    bonusText.setFillColor(Color::Yellow);
    bool gameOver = false;
    Text gameOverText(timerFont);
    gameOverText.setString("TRY AGAIN");
    gameOverText.setCharacterSize(38);
    gameOverText.setFillColor(Color::Red);
    FloatRect gameOverBounds = gameOverText.getLocalBounds();
    gameOverText.setOrigin({ // where the game over message will be displayed
        gameOverBounds.position.x + gameOverBounds.size.x / 2.f,
        gameOverBounds.position.y + gameOverBounds.size.y / 2.f
        });
    gameOverText.setPosition({ 400.f, 325.f });
    RectangleShape restartButton({ 220.f, 60.f });
    restartButton.setPosition({ 290.f, 500.f });
    restartButton.setFillColor(Color(25, 155, 55));
    restartButton.setOutlineColor(Color::White);
    restartButton.setOutlineThickness(3.f);
    Text restartText(timerFont);
    restartText.setString("RESTART");
    restartText.setCharacterSize(30);
    restartText.setFillColor(Color::White);
    Text finalCoinsText(timerFont);
    finalCoinsText.setCharacterSize(28);
    finalCoinsText.setFillColor(Color::White);
    Text finalTimeText(timerFont);
    finalTimeText.setCharacterSize(28);
    finalTimeText.setFillColor(Color::White);
    FloatRect restartBounds = restartText.getLocalBounds();
    restartText.setOrigin({
        restartBounds.position.x + restartBounds.size.x / 2.f,
        restartBounds.position.y + restartBounds.size.y / 2.f
        });
    restartText.setPosition({ 400.f, 530.f });
    while (window.isOpen())
    {
        float dt = clock.restart().asSeconds();
        int finalScore = 30 + coinsCollected * 3 - static_cast<int>(gameTimer.getElapsedTime().asSeconds());
        int secondsLeft = min(30, finalScore);  //this doesnt let the time exceed 30sec
        if (secondsLeft <= 0) {
            secondsLeft = 0;
            if (!gameOver) {
                gameOver = true;
                victory = false;
                finalElapsed = gameTimer.getElapsedTime().asSeconds();
                if (coinsCollected > maxCoins) maxCoins = coinsCollected;
                ofstream info("info.txt");
                info << maxCoins << "\n" << bestTime << "\n";
            }
        }
        timerText.setString(to_string(secondsLeft));
        if (secondsLeft <= 10) timerCircle.setOutlineColor(Color::Red);
        else timerCircle.setOutlineColor(Color::Yellow);
        FloatRect timerBounds = timerText.getLocalBounds();
        timerText.setOrigin({ timerBounds.position.x + timerBounds.size.x / 2.f, timerBounds.position.y + timerBounds.size.y / 2.f });
        timerText.setPosition({ 755.f, 605.f });
        while (const optional event = window.pollEvent()) {
            if (event->is<Event::Closed>())
                window.close();
            if (const auto* mouse = event->getIf<Event::MouseButtonPressed>()) {    // Restart only when the green button is clicked
                if (gameOver && mouse->button == Mouse::Button::Left) {
                    Vector2f mousePosition = window.mapPixelToCoords(mouse->position);
                    if (restartButton.getGlobalBounds().contains(mousePosition)) {
                        lives = 3;
                        coinsCollected = 0;
                        coins.clear();
                        victory = false;
                        frog.setPosition({ 385.f, 610.f });
                        for (int h = 0; h < hearts.size(); h++) hearts[h].setFillColor(Color::Red);
                        gameTimer.restart();
                        clock.restart();
                        window.setTitle("Frogger Game");
                        gameOver = false;
                    }
                }
            }
            if (const auto* key = event->getIf<Event::KeyPressed>())
            {
                if (key->code == Keyboard::Key::Escape) window.close();
                if (!gameOver && key->code == Keyboard::Key::Up) frog.move({ 0, -30 });
                if (!gameOver && key->code == Keyboard::Key::Down) frog.move({ 0, 30 });
                if (!gameOver && key->code == Keyboard::Key::Left)  frog.move({ -30, 0 });
                if (!gameOver && key->code == Keyboard::Key::Right) frog.move({ 30, 0 });
            }
        }
        if (gameOver) {
            window.clear(Color(25, 25, 25));
            if (timerFontLoaded) {
                if (victory) gameOverText.setString("YOU DID IT!");
                else   gameOverText.setString("TRY AGAIN ");
                FloatRect endBounds = gameOverText.getLocalBounds();
                gameOverText.setOrigin({ endBounds.position.x + endBounds.size.x / 2.f, endBounds.position.y + endBounds.size.y / 2.f });
                gameOverText.setPosition({ 400.f, 325.f });
                window.draw(gameOverText);
                finalCoinsText.setString("Coins Collected: " + to_string(coinsCollected));
                FloatRect coinsBounds = finalCoinsText.getLocalBounds();
                finalCoinsText.setOrigin({ coinsBounds.position.x + coinsBounds.size.x / 2.f, coinsBounds.position.y + coinsBounds.size.y / 2.f });
                finalCoinsText.setPosition({ 400.f, 365.f });
                window.draw(finalCoinsText);
                finalTimeText.setString("Time Elapsed: " + to_string(static_cast<int>(finalElapsed)) + " seconds");
                FloatRect timeBounds = finalTimeText.getLocalBounds();
                finalTimeText.setOrigin({ timeBounds.position.x + timeBounds.size.x / 2.f, timeBounds.position.y + timeBounds.size.y / 2.f });
                finalTimeText.setPosition({ 400.f, 405.f });
                window.draw(finalTimeText);
            }
            window.draw(restartButton);
            if (timerFontLoaded) window.draw(restartText);
            window.display();
            continue;
        }
        Vector2f frogPos = frog.getPosition();  // Keep Frog Inside Screen
        //clamp returns largest or smallest value if our value is greater or smaller than that.
        frogPos.x = clamp(frogPos.x, 0.f, 770.f);
        frogPos.y = clamp(frogPos.y, 0.f, 620.f);
        frog.setPosition(frogPos);
        for (int w = 0; w < waterWaves.size(); w++) {
            WaterWave& wave = waterWaves[w];
            for (int d = 0; d < wave.dots.size(); d++) wave.dots[d].move({ wave.speed * dt, 0 });
            float x = wave.dots[0].getPosition().x;
            if (wave.speed > 0 && x > 800) {
                for (int d = 0; d < wave.dots.size(); d++)
                    wave.dots[d].move({ -880, 0 });
            }
            if (wave.speed < 0 && x < -90) {
                for (int d = 0; d < wave.dots.size(); d++)
                    wave.dots[d].move({ 890, 0 });
            }
        }
        if (coinSpawnClock.getElapsedTime().asSeconds() > 2.2f && coins.size() < 5) {   // Spawn coins at random positions atleast 2.2 seconds.
            Coin coin;
            coin.shape = CircleShape(10.f);
            coin.shape.setFillColor(Color(255, 215, 0));
            coin.shape.setOutlineColor(Color(255, 255, 180)); coin.shape.setOutlineThickness(2.f);
            // Coins spawn only on the river (y=115-245) or road (y=295-460).
            float y;
            if (rand() % 2 == 0)        //assuming 50-50 probability, which is not always true but works most of the time
                y = 125.f + static_cast<float>(rand() % 105); // for River(starts from 125 ad goes max till 105)
            else  y = 305.f + static_cast<float>(rand() % 140); // for Road

            coin.shape.setPosition({ static_cast<float>(rand() % 750), y });
            coins.push_back(coin); coinSpawnClock.restart();
        }
        for (int i = 0; i < coins.size(); i++) {
            if (frog.getGlobalBounds().findIntersection(coins[i].shape.getGlobalBounds())) {
                coinsCollected++;
                coins.erase(coins.begin() + i);
                i--;
                showBonus = true;
                bonusDisplayClock.restart();
            }
        }
        if (showBonus && bonusDisplayClock.getElapsedTime().asSeconds() > 1.2f) showBonus = false;

        for (int i = 0; i < logs.size(); i++) {     //movement of logs, logs.size() is the size of vector
            Log& log = logs[i];
            log.shape.move({ log.speed * dt, 0 });
            float x = log.shape.getPosition().x;
            if (log.speed > 0 && x > 800) log.shape.setPosition({ -120, log.shape.getPosition().y });
            if (log.speed < 0 && x < -120) log.shape.setPosition({ 800, log.shape.getPosition().y });
        }
        for (int i = 0; i < lilyPads.size(); i++)       //movement of lilypads
        {
            LilyPad& pad = lilyPads[i];
            pad.shape.move({ pad.speed * dt, 0 });
            float x = pad.shape.getPosition().x;
            if (pad.speed > 0 && x > 800)
            {
                pad.shape.setPosition({ -65,  pad.shape.getPosition().y });
            }
            if (pad.speed < 0 && x < -65)
                pad.shape.setPosition({ 800, pad.shape.getPosition().y });

        }
        for (int i = 0; i < cars.size(); i++)
        {
            Car& car = cars[i];
            car.shape.move({ car.speed * dt, 0 });
            float x = car.shape.getPosition().x;
            if (car.speed > 0 && x > 810) car.shape.setPosition({ -65,  car.shape.getPosition().y });
            if (car.speed < 0 && x < -65) car.shape.setPosition({ 810, car.shape.getPosition().y });
        }
        bool collision = false, onRiverObject = false;
        float riverSpeed = 0;
        for (int i = 0; i < cars.size(); i++) {
            Car& car = cars[i];
            if (frog.getGlobalBounds().findIntersection(cars[i].shape.getGlobalBounds()))   // findIntersection() checks whether two objects' bounding boxes overlap.
            {
                collision = true;
                break;
            }
        }
        if (frog.getPosition().y >= 115 && frog.getPosition().y <= 205)  // Check if the frog is inside the river area.
        {
            for (int i = 0; i < logs.size(); i++) {
                Log& log = logs[i];
                if (frog.getGlobalBounds().findIntersection(logs[i].shape.getGlobalBounds()))
                {
                    onRiverObject = true;
                    riverSpeed = log.speed;  // Get the speed of the log carrying the frog.
                    break;
                }
            }
            if (!onRiverObject)    // If no log is found, check whether the frog is standing on a lily pad.
            {
                for (int i = 0; i < lilyPads.size(); i++) {
                    LilyPad& pad = lilyPads[i];
                    if (frog.getGlobalBounds().findIntersection(lilyPads[i].shape.getGlobalBounds()))
                    {
                        onRiverObject = true;
                        riverSpeed = pad.speed;
                        break;
                    }
                }
            }
            // If the frog is not on a log or lily pad, it falls into the water
            if (!onRiverObject) { collision = true; }
            else {
                frog.move({ riverSpeed * dt, 0 });//riverSpeed* dt provides smooth movement with the floating object, independent of frame rate.
            }
        }
        Vector2f currentFrogPos = frog.getPosition();// Keep frog inside the screen
        if (currentFrogPos.x < 0 || currentFrogPos.x > 770)
            collision = true;
        if (collision)
        {
            lives--;
            if (lives >= 0)
                hearts[lives].setFillColor(Color(110, 110, 110));   // Change the lost heart's colour to grey.
            frog.setPosition({ 385, 610 }); // Reset the frog to its starting position after losing a life.
            if (lives <= 0) {
                gameOver = true;
                finalElapsed = gameTimer.getElapsedTime().asSeconds();
                if (coinsCollected > maxCoins) maxCoins = coinsCollected;
                ofstream info("info.txt");
                info << maxCoins << "\n" << bestTime << "\n";
            }
        }
        if (!gameOver && frog.getGlobalBounds().findIntersection(door.getGlobalBounds()))
        {
            gameOver = true;
            victory = true;
            finalElapsed = gameTimer.getElapsedTime().asSeconds();
            if (coinsCollected > maxCoins) maxCoins = coinsCollected;
            if (finalElapsed < bestTime) bestTime = finalElapsed;
            ofstream info("info.txt");
            info << maxCoins << "\n" << bestTime << "\n";
        }
        window.clear(); // Clear the previous frame and draw the background and game environment.
        window.draw(background);
        window.draw(goal);
        window.draw(house);
        window.draw(roof);
        window.draw(door);
        window.draw(houseWindow);
        window.draw(river);
        window.draw(riverTop);
        window.draw(riverBottom);
        for (int w = 0; w < waterWaves.size(); w++) { //Nested loops are used to access and draw multiple dots stored inside different water wave objects.
            for (int d = 0; d < waterWaves[w].dots.size(); d++)
                window.draw(waterWaves[w].dots[d]);
        }
        for (int i = 0; i < logs.size(); i++) {
            Log& log = logs[i];
            window.draw(logs[i].shape);
            RectangleShape line({ 3.f, 20.f });
            line.setFillColor(Color(80, 40, 15));
            Vector2f pos = logs[i].shape.getPosition();
            line.setPosition({ pos.x + 35, pos.y + 2 });
            window.draw(line);
            line.setPosition({ pos.x + 75, pos.y + 2 });
            window.draw(line);
        }
        for (int i = 0; i < lilyPads.size(); i++) {
            LilyPad& pad = lilyPads[i];
            window.draw(lilyPads[i].shape);
            CircleShape center(5.f);
            center.setFillColor(Color(20, 120, 20));
            Vector2f pos = lilyPads[i].shape.getPosition();
            center.setPosition({ pos.x + 28, pos.y + 12 });
            window.draw(center);
        }
        window.draw(road);
        for (int y = 290; y <= 410; y += 60) {//A loop with an increment of 60 creates equally spaced road markings,lanes are made.
            RectangleShape line({ 800, 2 });
            line.setPosition({ 0,static_cast<float>(y) });//setPosition() uses Vector2f, which stores two floating point values.
            line.setFillColor(Color::White);
            window.draw(line);
        }
        for (int i = 0; i < cars.size(); i++) {        //narrow downed the size of cars
            Car& car = cars[i];
            Vector2f pos = cars[i].shape.getPosition();
            Color carColor = cars[i].shape.getFillColor();
            RectangleShape body({ 65, 28 });
            body.setPosition({ pos.x, pos.y + 4 });
            body.setFillColor(carColor);
            RectangleShape cabin({ 40, 18 });
            cabin.setPosition({ pos.x + 12, pos.y - 10 });
            cabin.setFillColor(carColor);
            RectangleShape window1({ 16, 13 });
            window1.setPosition({ pos.x + 15, pos.y - 8 });
            window1.setFillColor(Color(180, 220, 240));
            RectangleShape window2({ 16, 13 });
            window2.setPosition({ pos.x + 34, pos.y - 8 });
            window2.setFillColor(Color(180, 220, 240));
            CircleShape wheel1(7);
            wheel1.setPosition({ pos.x + 8, pos.y + 23 });
            wheel1.setFillColor(Color::Black);
            CircleShape wheel2(7);
            wheel2.setPosition({ pos.x + 49, pos.y + 23 });
            wheel2.setFillColor(Color::Black);
            window.draw(body);
            window.draw(cabin);
            window.draw(window1);
            window.draw(window2);
            window.draw(wheel1);
            window.draw(wheel2);
        }
        for (int i = 0; i < coins.size(); i++) window.draw(coins[i].shape);
        if (showBonus) { bonusText.setString("+3"); bonusText.setPosition({ 680.f, 600.f }); window.draw(bonusText); }
        //replacing the green dot with an actual frog stucture
        CircleShape leftLeg(10);// Create the left and right legs using scaled ellipses.
        leftLeg.setScale({ 1.2f, 0.8f });
        leftLeg.setPosition({ frogPos.x - 8, frogPos.y + 13 });
        leftLeg.setFillColor(Color(20, 130, 30));
        CircleShape rightLeg(10);
        rightLeg.setScale({ 1.2f, 0.8f });
        rightLeg.setPosition({ frogPos.x + 13, frogPos.y + 13 });
        rightLeg.setFillColor(Color(20, 130, 30));
        CircleShape frogBody(15);
        frogBody.setScale({ 0.85f, 1.1f }); //setScale() changes the width and height proportions of a shape.
        frogBody.setPosition({ frogPos.x + 2, frogPos.y + 2 });
        frogBody.setFillColor(Color(0, 190, 50));
        CircleShape frogHead(10);
        frogHead.setPosition({ frogPos.x + 5, frogPos.y - 3 });
        frogHead.setFillColor(Color(0, 210, 50));
        CircleShape leftEye(5);
        leftEye.setPosition({ frogPos.x + 2, frogPos.y - 7 });
        leftEye.setFillColor(Color::White);
        CircleShape rightEye(5);
        rightEye.setPosition({ frogPos.x + 18, frogPos.y - 7 });
        rightEye.setFillColor(Color::White);
        CircleShape leftPupil(2);
        leftPupil.setPosition({ frogPos.x + 5, frogPos.y - 5 });
        leftPupil.setFillColor(Color::Black);
        CircleShape rightPupil(2);
        rightPupil.setPosition({ frogPos.x + 21, frogPos.y - 5 }); //setPosition() places each body part relative to the frog's main position.
        rightPupil.setFillColor(Color::Black);
        window.draw(leftLeg);
        window.draw(rightLeg);
        window.draw(frogBody);
        window.draw(frogHead);
        window.draw(leftEye);
        window.draw(rightEye);
        window.draw(leftPupil);
        window.draw(rightPupil);
        for (int i = 0; i < hearts.size(); i++)
            window.draw(hearts[i]);
        window.draw(timerCircle);
        if (timerFontLoaded)
            window.draw(timerText);
        window.display();// Display the completed frame on the game window.
    }
    return 0;
}
