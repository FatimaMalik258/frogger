#include <SFML/Graphics.hpp>
#include <optional>
#include <vector>
#include <algorithm>
#include <string>
#include <cmath>
#include <fstream>
#include <cstdlib>
#include <ctime>
struct Log {
    sf::RectangleShape shape;
    float speed;
};
struct LilyPad {
    sf::ConvexShape shape;
    float speed;
};
//struct is used to create structure
struct Car
{
    sf::RectangleShape shape;
    float speed;
};
struct WaterWave
{
    //vector is used to store multiple elements
    std::vector<sf::CircleShape> dots;
    float speed;
};
struct Coin { sf::CircleShape shape; };
int main()
{
    //height is incresed from 600 to 650 to adjust river into the window
    sf::RenderWindow window(
        sf::VideoMode({ 800, 650 }),
        "Frogger Game"
    );
    window.setFramerateLimit(60);
    sf::RectangleShape background({ 800, 650 });
    background.setFillColor(sf::Color(50, 150, 60));
    sf::RectangleShape goal({ 800, 75 });
    goal.setPosition({ 0, 0 });
    goal.setFillColor(sf::Color(30, 180, 70));
    sf::RectangleShape house({ 100, 45 });
    house.setPosition({ 350, 25 });
    house.setFillColor(sf::Color(139, 69, 19));
    sf::ConvexShape roof;
    // 3 tells us that roof polygon will have 3 points
    roof.setPointCount(3);
    roof.setPoint(0, { 340, 25 });
    roof.setPoint(1, { 400, -10 });
    roof.setPoint(2, { 460, 25 });
    roof.setFillColor(sf::Color::Red);
    sf::RectangleShape door({ 25, 35 });
    door.setPosition({ 387, 35 });
    door.setFillColor(sf::Color(80, 40, 20));
    sf::RectangleShape houseWindow({ 20, 18 });
    houseWindow.setPosition({ 360, 38 });
    houseWindow.setFillColor(sf::Color::Cyan);
    //flowing river is added
    sf::RectangleShape river({ 800, 130 });
    river.setPosition({ 0, 115 });
    river.setFillColor(sf::Color(0, 100, 255));
    // River Borders
    sf::RectangleShape riverTop({ 800, 4 });
    riverTop.setPosition({ 0, 115 });
    riverTop.setFillColor(sf::Color::White);
    sf::RectangleShape riverBottom({ 800, 4 });
    riverBottom.setPosition({ 0, 241 });
    riverBottom.setFillColor(sf::Color::White);
    std::vector<WaterWave> waterWaves;
    //values of y are for waves at different heights inside river
    for (int y : {135, 165, 190})
    {
        for (int x = 0; x < 800; x += 200)
        {
            WaterWave wave;
            wave.speed = (y == 165) ? -45.f : 45.f;
            for (int i = 0; i < 9; i++)
            {
                sf::CircleShape dot(2.5f);
                //wave vertical position
                float waveY =
                    static_cast<float>(y) +
                    std::sin(i * 0.8f) * 4.f;
                dot.setPosition({
                    static_cast<float>(x + i * 10),
                    waveY
                    });
                dot.setFillColor(
                    sf::Color(150, 220, 255)
                );
                wave.dots.push_back(dot);
            }
            waterWaves.push_back(wave);
        }
    }
    //Road moved 90 pixels down and height reduced by 40 pixels
    //road now has four traffic lanes instead of five
    sf::RectangleShape road({ 800, 165 });
    road.setPosition({ 0, 295 });
    road.setFillColor(sf::Color(65, 65, 65));
    sf::CircleShape frog(15);
    frog.setFillColor(sf::Color::Green);
    frog.setPosition({ 385, 610 });
    std::vector<Car> cars;
    std::vector<Log> logs;
    std::vector<LilyPad> lilyPads;
    // Function to create logs
    auto addLog = [&](float x, float y, float speed)
        {
            sf::RectangleShape log({ 120.f, 25.f });
            log.setPosition({ x, y });
            log.setFillColor(sf::Color(120, 65, 25));
            logs.push_back({ log, speed });
        };
    // Function to create lily pads
    auto addLilyPad = [&](float x, float y, float speed)
        {
            sf::ConvexShape pad;
            pad.setPointCount(7);
            pad.setPoint(0, { 32.f, 0.f });
            pad.setPoint(1, { 53.f, 7.f });
            pad.setPoint(2, { 65.f, 20.f });
            pad.setPoint(3, { 48.f, 34.f });
            pad.setPoint(4, { 20.f, 34.f });
            pad.setPoint(5, { 0.f, 20.f });
            pad.setPoint(6, { 15.f, 12.f });
            pad.setPosition({ x, y });
            pad.setFillColor(sf::Color(50, 180, 50));
            pad.setOutlineColor(sf::Color(20, 110, 25));
            pad.setOutlineThickness(2.f);
            lilyPads.push_back({ pad, speed });
        };
    // Add flowing logs and lily pads
    addLog(30, 130, 65);
    addLog(350, 130, 65);
    addLog(670, 130, 65);
    addLilyPad(100, 160, -55);
    addLilyPad(350, 160, -55);
    addLilyPad(600, 160, -55);
    addLog(150, 185, 80);
    addLog(500, 185, 80);
    //reduced width of car from 90 to 65
    //used lambda to call this function again to make cars
    auto addCar = [&](float x, float y,
        sf::Color color, float speed)
        {
            sf::RectangleShape car({ 65, 32 });
            car.setPosition({ x, y });
            car.setFillColor(color);
            cars.push_back({ car, speed });
        };
    //removed some cars to balance out the road and make it easier to pass
    addCar(50, 290, sf::Color::Red, 180);
    addCar(367.5f, 290, sf::Color::Red, 180);
    addCar(685, 290, sf::Color::Red, 180);
    addCar(100, 350, sf::Color::Blue, -150);
    addCar(400, 350, sf::Color::Blue, -150);
    addCar(700, 350, sf::Color::Blue, -150);
    addCar(223, 410, sf::Color::Yellow, 200);
    addCar(512, 410, sf::Color::Yellow, 200);
    sf::Clock clock;
    int score = 0;
    int lives = 3;
    bool victory = false;
    int coinsCollected = 0;
    int maxCoins = 0;
    float bestTime = 0.f;
    { std::ifstream info("info.txt"); if (info >> maxCoins >> bestTime) {} }
    std::vector<Coin> coins;
    sf::Clock coinSpawnClock;
    sf::Clock bonusDisplayClock;
    bool showBonus = false;
    // Coin spawning is randomized along the playable path.
    std::srand(static_cast<unsigned>(std::time(nullptr)));
    //convex shape allows flexibility
    std::vector<sf::ConvexShape> hearts;
    for (int i = 0; i < 3; i++)
    {
        sf::ConvexShape heart;
        //to form heart we need 12 cordinates
        heart.setPointCount(12);
        heart.setPoint(0, { 20.f, 40.f });
        heart.setPoint(1, { 5.f, 25.f });
        heart.setPoint(2, { 0.f, 15.f });
        heart.setPoint(3, { 2.f, 7.f });
        heart.setPoint(4, { 8.f, 2.f });
        heart.setPoint(5, { 15.f, 3.f });
        heart.setPoint(6, { 20.f, 10.f });
        heart.setPoint(7, { 25.f, 3.f });
        heart.setPoint(8, { 32.f, 2.f });
        heart.setPoint(9, { 38.f, 7.f });
        heart.setPoint(10, { 40.f, 15.f });
        heart.setPoint(11, { 35.f, 25.f });
        heart.setFillColor(sf::Color::Red);
        heart.setOutlineColor(sf::Color::White);
        heart.setOutlineThickness(1.5f);
        heart.setScale({ 0.9f, 0.9f });
        heart.setPosition({ 20.f + i * 48.f, 570.f });
        hearts.push_back(heart);
    }
    //added timer using SFML class (clock)
    sf::Clock gameTimer;
    sf::CircleShape timerCircle(35.f);
    timerCircle.setPosition({ 720.f, 570.f });
    timerCircle.setFillColor(sf::Color(35, 35, 35));
    timerCircle.setOutlineThickness(4.f);
    timerCircle.setOutlineColor(sf::Color::Yellow);
    sf::Font timerFont;
    bool timerFontLoaded = timerFont.openFromFile("C:/Windows/Fonts/arial.ttf");
    sf::Text timerText(timerFont);
    timerText.setCharacterSize(24);
    timerText.setFillColor(sf::Color::White);
    timerText.setString("30");
    sf::Text bonusText(timerFont);
    bonusText.setCharacterSize(22);
    bonusText.setFillColor(sf::Color::Yellow);
    bool gameOver = false;
    sf::Text gameOverText(timerFont);
    gameOverText.setString("TRY AGAIN");
    gameOverText.setCharacterSize(38);
    gameOverText.setFillColor(sf::Color::Red);
    sf::FloatRect gameOverBounds = gameOverText.getLocalBounds();
    //where the game over message will be displayed
    gameOverText.setOrigin({
        gameOverBounds.position.x + gameOverBounds.size.x / 2.f,
        gameOverBounds.position.y + gameOverBounds.size.y / 2.f
        });
    gameOverText.setPosition({ 400.f, 325.f });
    sf::RectangleShape restartButton({ 220.f, 60.f });
    restartButton.setPosition({ 290.f, 390.f });
    restartButton.setFillColor(sf::Color(25, 155, 55));
    restartButton.setOutlineColor(sf::Color::White);
    restartButton.setOutlineThickness(3.f);
    sf::Text restartText(timerFont);
    restartText.setString("RESTART");
    restartText.setCharacterSize(30);
    restartText.setFillColor(sf::Color::White);
    //added scorecount
    sf::Text finalScoreText(timerFont);
    finalScoreText.setCharacterSize(28);
    finalScoreText.setFillColor(sf::Color::White);
    sf::FloatRect restartBounds = restartText.getLocalBounds();
    restartText.setOrigin({
        restartBounds.position.x + restartBounds.size.x / 2.f,
        restartBounds.position.y + restartBounds.size.y / 2.f
        });
    restartText.setPosition({ 400.f, 420.f });
    while (window.isOpen())
    {
        float dt = clock.restart().asSeconds();
        int secondsLeft = std::min(30, 30 + coinsCollected * 3 - static_cast<int>(
            gameTimer.getElapsedTime().asSeconds()
            ));
        if (secondsLeft <= 0)
        {
            secondsLeft = 0;
            gameOver = true;
            victory = false;
        }
        timerText.setString(std::to_string(secondsLeft));
        if (secondsLeft <= 10)
            timerCircle.setOutlineColor(sf::Color::Red);
        else
            timerCircle.setOutlineColor(sf::Color::Yellow);
        sf::FloatRect timerBounds = timerText.getLocalBounds();
        timerText.setOrigin({
            timerBounds.position.x + timerBounds.size.x / 2.f,
            timerBounds.position.y + timerBounds.size.y / 2.f
            });
        timerText.setPosition({ 755.f, 605.f });
        while (const std::optional event = window.pollEvent())
        {
            if (event->is<sf::Event::Closed>())
                window.close();
            // Restart only when the green button is clicked
            if (const auto* mouse =
                event->getIf<sf::Event::MouseButtonPressed>())
            {
                if (gameOver && mouse->button == sf::Mouse::Button::Left)
                {
                    sf::Vector2f mousePosition =
                        window.mapPixelToCoords(mouse->position);
                    if (restartButton.getGlobalBounds().contains(mousePosition))
                    {
                        lives = 3;
                        score = 0;
                        coinsCollected = 0;
                        coins.clear();
                        victory = false;
                        frog.setPosition({ 385.f, 610.f });
                        for (auto& heart : hearts)
                            heart.setFillColor(sf::Color::Red);

                        gameTimer.restart();
                        clock.restart();
                        window.setTitle("Frogger Game");
                        gameOver = false;
                    }
                }
            }
            if (const auto* key =
                event->getIf<sf::Event::KeyPressed>())
            {
                if (key->code == sf::Keyboard::Key::Escape)
                    window.close();
                if (!gameOver && key->code == sf::Keyboard::Key::Up)
                    frog.move({ 0, -40 });
                if (!gameOver && key->code == sf::Keyboard::Key::Down)
                    frog.move({ 0, 40 });
                if (!gameOver && key->code == sf::Keyboard::Key::Left)
                    frog.move({ -40, 0 });
                if (!gameOver && key->code == sf::Keyboard::Key::Right)
                    frog.move({ 40, 0 });
            }
        }
        if (gameOver)
        {
            window.clear(sf::Color(25, 25, 25));
            if (timerFontLoaded)
            {
                gameOverText.setString(victory ? "YOU DID IT!" : "TRY AGAIN");
                sf::FloatRect endBounds = gameOverText.getLocalBounds();
                gameOverText.setOrigin({ endBounds.position.x + endBounds.size.x / 2.f, endBounds.position.y + endBounds.size.y / 2.f });
                gameOverText.setPosition({ 400.f, 325.f });
                window.draw(gameOverText);
                finalScoreText.setString(
                    "Total Score: " + std::to_string(score)
                );
                sf::FloatRect scoreBounds = finalScoreText.getLocalBounds();
                finalScoreText.setOrigin({
                    scoreBounds.position.x + scoreBounds.size.x / 2.f,
                    scoreBounds.position.y + scoreBounds.size.y / 2.f
                    });
                finalScoreText.setPosition({ 400.f, 365.f });
                window.draw(finalScoreText);
            }
            window.draw(restartButton);
            if (timerFontLoaded)
                window.draw(restartText);
            window.display();
            continue;
        }
        // Keep Frog Inside Screen
        sf::Vector2f frogPos = frog.getPosition();
        frogPos.x = std::clamp(frogPos.x, 0.f, 770.f);
        frogPos.y = std::clamp(frogPos.y, 0.f, 620.f);
        frog.setPosition(frogPos);
        for (auto& wave : waterWaves)
        {
            for (auto& dot : wave.dots)
                //for movement
                dot.move({ wave.speed * dt, 0 });
            float x = wave.dots[0].getPosition().x;
            if (wave.speed > 0 && x > 800)
            {
                for (auto& dot : wave.dots)
                    dot.move({ -880, 0 });
            }
            if (wave.speed < 0 && x < -90)
            {
                for (auto& dot : wave.dots)
                    dot.move({ 890, 0 });
            }
        }
        // Spawn coins at random positions every few seconds.
        if (coinSpawnClock.getElapsedTime().asSeconds() > 2.2f && coins.size() < 5) {
            Coin coin; coin.shape = sf::CircleShape(10.f);
            coin.shape.setFillColor(sf::Color(255, 215, 0));
            coin.shape.setOutlineColor(sf::Color(255, 255, 180)); coin.shape.setOutlineThickness(2.f);
            // Coins spawn only within the river (115-245) or road (295-460).
            float y;
            if (rand() % 2 == 0)
                y = 125.f + static_cast<float>(rand() % 105); // River
            else
                y = 305.f + static_cast<float>(rand() % 140); // Road
            coin.shape.setPosition({ static_cast<float>(rand() % 750), y });
            coins.push_back(coin); coinSpawnClock.restart();
        }
        for (auto it = coins.begin(); it != coins.end();) {
            if (frog.getGlobalBounds().findIntersection(it->shape.getGlobalBounds())) {
                coinsCollected++; it = coins.erase(it); showBonus = true; bonusDisplayClock.restart();
            }
            else ++it;
        }
        if (showBonus && bonusDisplayClock.getElapsedTime().asSeconds() > 1.2f) showBonus = false;
        //For the movement of logs
        for (auto& log : logs)
        {
            log.shape.move({ log.speed * dt, 0 });
            float x = log.shape.getPosition().x;
            if (log.speed > 0 && x > 800)
            {
                log.shape.setPosition({
                    -120,
                    log.shape.getPosition().y
                    });
            }
            if (log.speed < 0 && x < -120)
            {
                log.shape.setPosition({
                    800,
                    log.shape.getPosition().y
                    });
            }
        }
        //for the movement of lily pads
        for (auto& pad : lilyPads)
        {
            pad.shape.move({ pad.speed * dt, 0 });
            float x = pad.shape.getPosition().x;
            if (pad.speed > 0 && x > 800)
            {
                pad.shape.setPosition({
                    -65,
                    pad.shape.getPosition().y
                    });
            }
            if (pad.speed < 0 && x < -65)
            {
                pad.shape.setPosition({
                    800,
                    pad.shape.getPosition().y
                    });
            }
        }
        for (auto& car : cars)
        {
            car.shape.move({ car.speed * dt, 0 });
            float x = car.shape.getPosition().x;
            if (car.speed > 0 && x > 810)
            {
                car.shape.setPosition({
                    -65,
                    car.shape.getPosition().y
                    });
            }
            if (car.speed < 0 && x < -65)
            {
                car.shape.setPosition({
                    810,
                    car.shape.getPosition().y
                    });
            }
        }
        bool collision = false;
        bool onRiverObject = false;
        float riverSpeed = 0;
        // Check collision with cars
        for (const auto& car : cars)
        {
            if (frog.getGlobalBounds().findIntersection(
                car.shape.getGlobalBounds()))
            {
                collision = true;
                break;
            }
        }
        // Check if frog is standing on a log or lily pad
        if (frog.getPosition().y >= 115 &&
            frog.getPosition().y <= 205)
        {
            // Check collision with logs
            for (const auto& log : logs)
            {
                if (frog.getGlobalBounds().findIntersection(
                    log.shape.getGlobalBounds()))
                {
                    onRiverObject = true;
                    riverSpeed = log.speed;
                    break;
                }
            }
            // Check collision with lily pads
            if (!onRiverObject)
            {
                for (const auto& pad : lilyPads)
                {
                    if (frog.getGlobalBounds().findIntersection(
                        pad.shape.getGlobalBounds()))
                    {
                        onRiverObject = true;
                        riverSpeed = pad.speed;
                        break;
                    }
                }
            }
            // Frog falls into water if not on an object
            if (!onRiverObject)
            {
                collision = true;
            }
            else
            {
                // Move frog with the floating object
                frog.move({ riverSpeed * dt, 0 });
            }
        }
        // Keep frog inside the screen
        sf::Vector2f currentFrogPos = frog.getPosition();
        if (currentFrogPos.x < 0 || currentFrogPos.x > 770)
            collision = true;
        // Lose a life
        if (collision)
        {
            lives--;

            if (lives >= 0)
                hearts[lives].setFillColor(
                    sf::Color(110, 110, 110));
            frog.setPosition({ 385, 610 });
            if (lives <= 0)
                gameOver = true;
        }
        // Win only when the frog overlaps the house door.
        if (!gameOver && frog.getGlobalBounds().findIntersection(door.getGlobalBounds()))
        {
            score++;
            gameOver = true;
            victory = true;
            float elapsed = gameTimer.getElapsedTime().asSeconds();
            if (coinsCollected > maxCoins) maxCoins = coinsCollected;
            if (bestTime <= 0.f || elapsed < bestTime) bestTime = elapsed;
            std::ofstream info("info.txt");
            info << maxCoins << "\n" << bestTime << "\n";
        }
        window.clear();
        window.draw(background);
        window.draw(goal);
        window.draw(house);
        window.draw(roof);
        window.draw(door);
        window.draw(houseWindow);
        window.draw(river);
        window.draw(riverTop);
        window.draw(riverBottom);
        // Draw logs
        for (const auto& log : logs)
        {
            window.draw(log.shape);
            sf::RectangleShape line({ 3.f, 20.f });
            line.setFillColor(sf::Color(80, 40, 15));
            sf::Vector2f pos = log.shape.getPosition();
            line.setPosition({ pos.x + 35, pos.y + 2 });
            window.draw(line);
            line.setPosition({ pos.x + 75, pos.y + 2 });
            window.draw(line);
        }
        // Draw lily pads
        for (const auto& pad : lilyPads)
        {
            window.draw(pad.shape);
            // Lily pad center
            sf::CircleShape center(5.f);
            center.setFillColor(sf::Color(20, 120, 20));
            sf::Vector2f pos = pad.shape.getPosition();
            center.setPosition({ pos.x + 28, pos.y + 12 });
            window.draw(center);
        }
        for (const auto& wave : waterWaves)
        {
            for (const auto& dot : wave.dots)
                window.draw(dot);
        }
        window.draw(road);
        for (int y = 290; y <= 410; y += 60)
        {
            sf::RectangleShape line({ 800, 2 });
            line.setPosition({
                0,
                static_cast<float>(y)
                });
            line.setFillColor(sf::Color::White);
            window.draw(line);
        }
        //narrow dowed the size of cars
        for (const auto& car : cars)
        {
            sf::Vector2f pos = car.shape.getPosition();
            sf::Color carColor = car.shape.getFillColor();
            sf::RectangleShape body({ 65, 28 });
            body.setPosition({ pos.x, pos.y + 4 });
            body.setFillColor(carColor);
            sf::RectangleShape cabin({ 40, 18 });
            cabin.setPosition({ pos.x + 12, pos.y - 10 });
            cabin.setFillColor(carColor);
            sf::RectangleShape window1({ 16, 13 });
            window1.setPosition({ pos.x + 15, pos.y - 8 });
            window1.setFillColor(sf::Color(180, 220, 240));
            sf::RectangleShape window2({ 16, 13 });
            window2.setPosition({ pos.x + 34, pos.y - 8 });
            window2.setFillColor(sf::Color(180, 220, 240));
            sf::CircleShape wheel1(7);
            wheel1.setPosition({ pos.x + 8, pos.y + 23 });
            wheel1.setFillColor(sf::Color::Black);
            sf::CircleShape wheel2(7);
            wheel2.setPosition({ pos.x + 49, pos.y + 23 });
            wheel2.setFillColor(sf::Color::Black);
            window.draw(body);
            window.draw(cabin);
            window.draw(window1);
            window.draw(window2);
            window.draw(wheel1);
            window.draw(wheel2);
        }
        for (const auto& coin : coins) window.draw(coin.shape);
        if (showBonus) { bonusText.setString("+3"); bonusText.setPosition({ 680.f, 600.f }); window.draw(bonusText); }
        //replacing the green dot with an actual frog stucture
        sf::CircleShape leftLeg(10);
        leftLeg.setScale({ 1.2f, 0.8f });
        leftLeg.setPosition({ frogPos.x - 8, frogPos.y + 13 });
        leftLeg.setFillColor(sf::Color(20, 130, 30));
        sf::CircleShape rightLeg(10);
        rightLeg.setScale({ 1.2f, 0.8f });
        rightLeg.setPosition({ frogPos.x + 13, frogPos.y + 13 });
        rightLeg.setFillColor(sf::Color(20, 130, 30));
        sf::CircleShape frogBody(15);
        frogBody.setScale({ 0.85f, 1.1f });
        frogBody.setPosition({ frogPos.x + 2, frogPos.y + 2 });
        frogBody.setFillColor(sf::Color(0, 190, 50));
        sf::CircleShape frogHead(10);
        frogHead.setPosition({ frogPos.x + 5, frogPos.y - 3 });
        frogHead.setFillColor(sf::Color(0, 210, 50));
        sf::CircleShape leftEye(5);
        leftEye.setPosition({ frogPos.x + 2, frogPos.y - 7 });
        leftEye.setFillColor(sf::Color::White);
        sf::CircleShape rightEye(5);
        rightEye.setPosition({ frogPos.x + 18, frogPos.y - 7 });
        rightEye.setFillColor(sf::Color::White);
        sf::CircleShape leftPupil(2);
        leftPupil.setPosition({ frogPos.x + 5, frogPos.y - 5 });
        leftPupil.setFillColor(sf::Color::Black);
        sf::CircleShape rightPupil(2);
        rightPupil.setPosition({ frogPos.x + 21, frogPos.y - 5 });
        rightPupil.setFillColor(sf::Color::Black);
        // Displaying the frog parts
        window.draw(leftLeg);
        window.draw(rightLeg);
        window.draw(frogBody);
        window.draw(frogHead);
        window.draw(leftEye);
        window.draw(rightEye);
        window.draw(leftPupil);
        window.draw(rightPupil);
        for (const auto& heart : hearts)
            window.draw(heart);
        window.draw(timerCircle);
        if (timerFontLoaded)
            window.draw(timerText);
        window.display();
    }
    return 0;
}
